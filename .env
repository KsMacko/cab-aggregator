# Базы данных
MYSQL_ROOT_PASSWORD=root
DRIVER_DATABASE=driver_db
PASSENGER_DATABASE=passenger_db
FINANCE_DATABASE=finance_db
MYSQL_USER=user
MYSQL_PASSWORD=password
DB_PORT=3306

MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=ride_db

ZOOKEEPER_PORT=2181

KAFKA_PORT=9092
BOOTSTRAP_SERVERS=kafka:9092

ARTEMIS_PORT=61616
ARTEMIS_USER=admin
ARTEMIS_PASSWORD=admin

# Сервисы
DRIVER_SERVER_PORT=8082
PASSENGER_SERVER_PORT=8081
RIDE_SERVER_PORT=8083
FINANCE_SERVER_PORT=8084

# Имена сервисов в Docker Compose
DRIVER_SERVICE_URL=http://driver-service:8082/api/v1/drivers
FINANCE_SERVICE_URL=http://finance-service:8084/api/v1/finance
PASSENGER_SERVICE_URL=http://passenger-service:8081/api/v1/rates
RIDE_SERVICE_URL=http://ride-service:8083/api/v1/rides

LIQUIBASE_DRIVER_PATH=./driver-service/db/changelog:/liquibase/driver
LIQUIBASE_PASSENGER_PATH=./passenger-service/db/changelog:/liquibase/passenger
LIQUIBASE_FINANCE_PATH=./finance-service/db/changelog:/liquibase/finance
LIQUIBASE_RIDE_PATH=./ride-service/db/changelog:/liquibase/ride